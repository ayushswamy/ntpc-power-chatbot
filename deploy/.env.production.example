# =============================================================================
# Production settings for the NTPC Power Data Chatbot (Windows Server).
# The installer copies this file to C:\NTPC-Chatbot\.env - then fill in the values marked <...>.
# This file holds secrets: restrict it to administrators (the installer sets the permissions).
# =============================================================================

# ---------- SQL Server (read-only login) ----------
DB_SERVER=10.4.8.44
DB_NAME=DB_PlantLive
DB_USER=<read-only login>
DB_PASSWORD=<password - ask the DBA for a NEW strong password before go-live>
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_LOGIN_TIMEOUT_SECONDS=15
QUERY_TIMEOUT_SECONDS=30
MAX_ROWS=5000

# ---------- Live data ----------
LIVE_CACHE_TTL_SECONDS=60
LIVE_FRESHNESS_MINUTES=30

# ---------- Answers ----------
NTPC_TOTAL_SCOPE=group
LOG_DIR=logs
LOG_MAX_MB=50

# ---------- LLM ----------
# Option 1 - vLLM on a Linux GPU server (recommended for 20+ users at the same time):
#   LLM_PROVIDER=vllm
#   LLM_BASE_URL=http://<gpu-server>:8001/v1
#   LLM_MODEL=Qwen/Qwen3-32B-AWQ
#   LLM_API_KEY=<the --api-key given to vllm serve>
# Option 2 - Ollama on this server or a Windows GPU server:
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=qwen3:32b            (qwen3-8b-ntpc until the GPU is available)
#   LLM_API_KEY=ollama
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-8b-ntpc
LLM_TIMEOUT_SECONDS=300
LLM_DISABLE_THINKING=true
ANSWER_MODE=llm
WARMUP_ON_START=true

# ---------- Embeddings + vector DB ----------
# bge-m3 can stay on Ollama even when the LLM moves to vLLM
EMBED_BASE_URL=http://127.0.0.1:11434/v1
EMBED_MODEL=bge-m3
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=ntpc_chatbot

# ---------- API ----------
# Long random secret, shared ONLY with the ASP.NET forwarding handler (web.config ChatbotApiKey).
# Generate: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=<generate a new key - never reuse the development key>
RATE_LIMIT_PER_MINUTE=20
# 0 = off: behind the ASP.NET handler all requests come from the web server's address
RATE_LIMIT_PER_CLIENT_MINUTE=0
# With the ASP.NET forwarding handler the browser never calls this API directly, so no origins are needed
ALLOWED_ORIGINS=
# Questions the LLM handles at the same time (others queue):
#   CPU only: 1   |  Ollama + 24 GB GPU: 4 (set OLLAMA_NUM_PARALLEL=4)   |  vLLM + 48 GB GPU: 16
MAX_CONCURRENT_CHATS=1
SQLITE_PATH=data/chatbot.sqlite

DEBUG=false
