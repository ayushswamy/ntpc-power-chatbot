# Copy this file to ".env" and fill in the values.
# .env holds secrets: never share it, never commit it, never paste it into chats.

# ---------- SQL Server (read-only login) ----------
DB_SERVER=10.4.8.44
DB_NAME=DB_PlantLive
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_LOGIN_TIMEOUT_SECONDS=15
QUERY_TIMEOUT_SECONDS=30
MAX_ROWS=5000

# ---------- Live (real-time) data ----------
# How long a live query result may be reused for other users (max 60)
LIVE_CACHE_TTL_SECONDS=60
# Live values older than this are flagged as "feed may be delayed"
LIVE_FRESHNESS_MINUTES=30

# ---------- Answers ----------
# "NTPC total" = group (NTPC + JVs/subsidiaries) or standalone (NTPC-owned only)
NTPC_TOTAL_SCOPE=group
# Query log folder (no credentials or result data are logged)
LOG_DIR=logs

# ---------- LLM (OpenAI-compatible API) ----------
# Ollama:  http://localhost:11434/v1     vLLM: http://<server>:8000/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Production target: qwen3:32b (needs a GPU). This dev PC has no GPU -> qwen3:8b with an 8k context:
#   ollama create qwen3-8b-ntpc -f ollama\Modelfile.qwen3-8b-ntpc
LLM_MODEL=qwen3-8b-ntpc
LLM_TIMEOUT_SECONDS=300
# Qwen3 thinking mode off = ~4x faster on CPU
LLM_DISABLE_THINKING=true
# llm = LLM writes the answer (numbers checked against the data); template = fixed wording, faster
ANSWER_MODE=llm

# ---------- Embeddings + vector DB ----------
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ntpc_chatbot

# ---------- API ----------
# Shared secret between the ASP.NET web app and this backend (make it long and random).
# The API refuses all chat requests while this is empty or "change-me". Generate one with:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me
# Questions per minute per chat session (also per client address, x3)
RATE_LIMIT_PER_MINUTE=20
# Web pages (origins) allowed to call the API directly from the browser, comma-separated
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Questions the LLM handles at the same time; the rest wait in a queue (1 on CPU, 4+ on a GPU server)
MAX_CONCURRENT_CHATS=1
SQLITE_PATH=data/chatbot.sqlite

# true = include generated SQL in responses (development only)
DEBUG=false
